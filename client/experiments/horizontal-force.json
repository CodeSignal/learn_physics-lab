{
  "schemaVersion": 1, "id": "horizontal-force", "title": "1 · Horizontal force",
  "description": "Change the push, mass, or surface friction. Run it to observe F = ma and resistance from friction.",
  "concepts": ["Constant force and acceleration", "Contact friction opposes motion", "Mass controls response to force"],
  "environment": { "gravity": { "x": 0, "y": -9.81 }, "duration": 20, "timestep": 0.016666666666666666, "bounds": { "left": -8, "right": 8, "bottom": -4, "top": 5 } },
  "objects": [
    { "id": "floor", "label": "Floor", "shape": "platform", "bodyType": "fixed", "position": { "x": 0, "y": -0.775 }, "width": 200, "height": 0.45, "friction": 0.8, "render": { "color": "#56627c" } },
    { "id": "block", "label": "", "shape": "rectangle", "bodyType": "dynamic", "position": { "x": 0, "y": 0 }, "width": 1.1, "height": 1.1, "mass": 5, "friction": 0.3, "linearDamping": 0.03, "render": { "color": "#377dff" } }
  ],
  "forces": [{ "id": "push", "target": "block", "type": "constant-force", "vector": { "x": 16, "y": 0 }, "continuous": true }],
  "learnerControls": [
    { "id": "force", "label": "Applied force", "targetType": "force", "targetId": "push", "property": "magnitude", "min": 0, "max": 50, "step": 1, "unit": "N", "value": 16 },
    { "id": "mass", "label": "Block mass", "targetType": "object", "targetId": "block", "property": "mass", "min": 1, "max": 15, "step": 0.5, "unit": "kg", "value": 5 },
    { "id": "friction", "label": "Surface friction", "targetType": "object", "targetId": "block", "property": "friction", "min": 0, "max": 1, "step": 0.05, "unit": "μ", "value": 0.3 }
  ],
  "measurements": [
    { "objectId": "block", "property": "x", "label": "Position X", "unit": "m" },
    { "objectId": "block", "property": "speed", "label": "Speed", "unit": "m/s" },
    { "objectId": "block", "property": "netForce", "label": "Net force*", "unit": "N" },
    { "objectId": "block", "property": "mass", "label": "Mass", "unit": "kg" }
  ],
  "instrumentation": { "recording": { "enabled": true, "sampleInterval": 0.033333333, "maxSamples": 1200 }, "measurements": [{ "id": "block-x", "target": "block", "quantity": "position.x", "label": "Position X", "display": "both" }, { "id": "block-vx", "target": "block", "quantity": "velocity.x", "label": "Velocity X", "display": "both" }, { "id": "block-ax", "target": "block", "quantity": "acceleration.x", "label": "Estimated acceleration X", "display": "value" }, { "id": "block-force", "target": "block", "quantity": "appliedForce", "label": "Applied force", "display": "value" }], "vectors": [{ "target": "block", "quantity": "velocity", "enabled": true }], "graph": { "id": "position", "type": "line", "title": "Position vs. time", "series": ["block-x"], "yAxis": "Position (m)" } }
}
