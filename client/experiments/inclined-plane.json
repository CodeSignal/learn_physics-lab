{
  "schemaVersion": 1, "id": "inclined-plane", "title": "2 · Inclined plane",
  "description": "Explore the component of gravity pulling the block down the slope and the contact friction holding it back.",
  "concepts": ["Gravity resolved along a slope", "Numerical contact friction", "Mass-independent ideal acceleration"],
  "environment": { "gravity": { "x": 0, "y": -9.81 }, "duration": 20, "timestep": 0.016666666666666666, "bounds": { "left": -8, "right": 8, "bottom": -4, "top": 5 } },
  "objects": [
    { "id": "floor", "label": "Floor", "shape": "platform", "bodyType": "fixed", "position": { "x": 2.1, "y": -3.84 }, "width": 16, "height": 0.45, "friction": 0.8, "render": { "color": "#56627c" } },
    { "id": "ramp", "label": "Inclined plane", "shape": "ramp", "bodyType": "fixed", "position": { "x": 2.8, "y": -1.94 }, "width": 8, "height": 0.42, "rotation": -0.42, "friction": 0.56, "render": { "color": "#f99300" } },
    { "id": "slope-block", "label": "Slope block", "shape": "rectangle", "bodyType": "dynamic", "position": { "x": 0, "y": 0 }, "width": 0.9, "height": 0.9, "rotation": -0.42, "mass": 3, "friction": 0.38, "render": { "color": "#10a47b" } }
  ],
  "forces": [],
  "learnerControls": [
    { "id": "slope-mass", "label": "Block mass", "targetType": "object", "targetId": "slope-block", "property": "mass", "min": 1, "max": 12, "step": 0.5, "unit": "kg", "value": 3 },
    { "id": "gravity", "label": "Gravity", "targetType": "environment", "property": "gravityMagnitude", "min": 0, "max": 20, "step": 0.5, "unit": "m/s²", "value": 10 },
    { "id": "slope-friction", "label": "Incline friction", "targetType": "object", "targetId": "ramp", "property": "friction", "min": 0, "max": 1, "step": 0.05, "unit": "μ", "value": 0.55 }
  ],
  "measurements": [
    { "objectId": "slope-block", "property": "x", "label": "Position X", "unit": "m" },
    { "objectId": "slope-block", "property": "y", "label": "Position Y", "unit": "m" },
    { "objectId": "slope-block", "property": "speed", "label": "Speed", "unit": "m/s" },
    { "objectId": "slope-block", "property": "acceleration", "label": "Approx. acceleration", "unit": "m/s²" }
  ],
  "instrumentation": { "recording": { "enabled": true, "sampleInterval": 0.033333333, "maxSamples": 1200 }, "measurements": [{ "id": "slope-speed", "target": "slope-block", "quantity": "speed", "label": "Speed", "display": "both" }, { "id": "slope-ke", "target": "slope-block", "quantity": "totalKineticEnergy", "label": "Kinetic energy", "display": "both" }, { "id": "slope-pe", "target": "slope-block", "quantity": "potentialEnergy", "label": "Potential energy", "display": "both" }], "trails": [{ "target": "slope-block", "enabled": true, "color": "#10a47b", "sampleInterval": 0.033333333, "maxPoints": 500, "fade": true }], "vectors": [{ "target": "slope-block", "quantity": "velocity", "enabled": true }], "graph": { "id": "energy", "type": "line", "title": "Energy vs. time", "series": ["slope-ke", "slope-pe"], "yAxis": "Energy (J)" } }
}
